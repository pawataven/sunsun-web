---
import { Image } from 'astro:assets';
import QRCode from 'qrcode';
import { siLine } from 'simple-icons';
import Toast from '../components/Toast.astro';
import Layout from '../layouts/Layout.astro';
import logo from '../assets/logo/SUNSUN_PRINT.png';
import { lineAddFriendUrl, lineId } from '../data/contact';

// Level H tolerates the centre badge covering part of the code
const qrCodeSvg = await QRCode.toString(lineAddFriendUrl, {
	type: 'svg',
	errorCorrectionLevel: 'H',
	margin: 0,
	color: { dark: '#171717', light: '#ffffff' },
});

const scanSteps = ['เปิดแอป LINE', 'แตะสแกน QR', 'กดเพิ่มเพื่อน'];
---

<Layout
	title="SUNSUN PRINT | LINE Official"
	description={`เพิ่มเพื่อน SUNSUN PRINT ใน LINE ด้วยการสแกน QR code หรือค้นหา ID ${lineId}`}
>
	<main class="mx-auto max-w-sm px-5 pt-5 pb-12">
		<a
			href="/"
			class="-ml-2 inline-flex items-center gap-1.5 px-2 py-2 text-sm text-white/60 transition hover:text-white focus-visible:outline-2 focus-visible:outline-white"
		>
			<svg
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				class="size-4"
				aria-hidden="true"
			>
				<path d="M19 12H5M11 6l-6 6 6 6"></path>
			</svg>
			กลับหน้าแรก
		</a>

		<h1 class="mt-8 text-center text-2xl font-bold motion-safe:animate-rise">เพิ่มเพื่อนทาง LINE</h1>
		<p class="mt-1.5 text-center text-sm text-white/55 motion-safe:animate-rise">สแกน QR แล้วทักมาสอบถามงานพิมพ์ได้เลย</p>

		<div class="relative mt-8 rounded-3xl bg-white p-5 motion-safe:animate-rise" style="animation-delay: 80ms">
			<div class="[&>svg]:block [&>svg]:size-full" set:html={qrCodeSvg} />
			<span
				class="absolute top-1/2 left-1/2 grid size-16 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-2xl border-4 border-white bg-brand"
				aria-hidden="true"
			>
				<Image src={logo} alt="" width={56} densities={[1, 2]} class="w-14" />
			</span>
		</div>

		<ol class="mt-4 flex items-center justify-center gap-2 text-xs text-white/55">
			{
				scanSteps.map((step, index) => (
					<li class="flex items-center gap-2">
						{index > 0 && <span class="text-white/25" aria-hidden="true">›</span>}
						{step}
					</li>
				))
			}
		</ol>

		<div class="mt-8 space-y-3 motion-safe:animate-rise" style="animation-delay: 160ms">
			<div class="flex h-14 items-center justify-between rounded-full border border-white/12 bg-white/3 pr-1.5 pl-5">
				<span class="text-sm">
					<span class="text-white/55">LINE ID</span>
					<span class="ml-2 font-bold">{lineId}</span>
				</span>
				<button
					type="button"
					id="copy-line-id"
					class="h-11 rounded-full bg-white px-5 text-sm font-bold text-ink transition hover:bg-ivory focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
				>
					คัดลอก
				</button>
			</div>

			<!-- line.me only opens the app on touch devices; on desktop it lands on LINE's own QR page, so the QR above covers that case -->
			<a
				href={lineAddFriendUrl}
				class="relative hidden h-14 items-center justify-center rounded-full bg-brand px-14 text-sm font-bold transition hover:bg-brand-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white pointer-coarse:flex"
			>
				<svg viewBox="0 0 24 24" class="absolute left-5 size-5 fill-current" aria-hidden="true">
					<path d={siLine.path}></path>
				</svg>
				เปิดใน LINE
			</a>
		</div>
	</main>

	<Toast />
</Layout>

<script>
	import { lineId } from '../data/contact';
	import { copyToClipboard } from '../scripts/toast';

	document.querySelector('#copy-line-id')?.addEventListener('click', () => {
		copyToClipboard(lineId, `คัดลอก ${lineId} แล้ว`);
	});
</script>

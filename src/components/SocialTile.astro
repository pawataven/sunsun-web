---
interface Props {
	href: string;
	label: string;
	handle: string;
	iconPath: string;
	iconBackgroundClass: string;
	animationDelayMs?: number;
}

const { href, label, handle, iconPath, iconBackgroundClass, animationDelayMs = 0 } = Astro.props;
---

<a
	href={href}
	style={`animation-delay: ${animationDelayMs}ms`}
	class="flex flex-col items-center gap-3 rounded-2xl border border-white/10 bg-white/3 px-2 py-5 text-center backdrop-blur-sm transition hover:-translate-y-0.5 hover:border-white/25 hover:bg-white/6 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-safe:animate-rise"
>
	<span class:list={['grid size-12 place-items-center rounded-xl text-white', iconBackgroundClass]}>
		<svg viewBox="0 0 24 24" class="size-6 fill-current" aria-hidden="true">
			<path d={iconPath}></path>
		</svg>
	</span>
	<span class="w-full min-w-0">
		<span class="block text-sm font-bold">{label}</span>
		<span class="block truncate text-[11px] text-white/55">{handle}</span>
	</span>
</a>
